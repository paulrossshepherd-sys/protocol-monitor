# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection for all server-side data access. On Vercel use
# Supabase's pooled (transaction-mode, port 6543) connection string.
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:6543/postgres

# --- Resend (§6.5) ---
RESEND_API_KEY=re_xxxxxxxx
# Svix signing secret for /api/webhooks/resend signature verification
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Sender identity (§8): identifiable sender on a domain with SPF/DKIM/DMARC
EMAIL_FROM="Protocol Monitor <digest@example.com>"
# Reply-to a human reads (§8)
EMAIL_REPLY_TO=you@example.com

# --- Admin ---
# The single admin user (Supabase Auth). Sign-ins by any other address are rejected.
ADMIN_EMAIL=you@example.com

# --- Sending limits (§6.5) ---
# Sends are blocked outright (never truncated) when confirmed subscribers minus
# suppressions exceeds this. 100 = Resend free-tier daily cap.
DAILY_SEND_CAP=100

# --- Cron (§6.2) ---
# Shared secret; the daily poll route rejects requests without it.
# Vercel Cron sends it automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=generate-a-long-random-string

# --- gov.uk polling etiquette (§4.4) ---
# Contact address included in the User-Agent on every gov.uk fetch.
GOVUK_CONTACT_EMAIL=you@example.com

# --- Site ---
# Absolute base URL used in emails (unsubscribe/confirm links) and metadata.
NEXT_PUBLIC_SITE_URL=https://example.com
